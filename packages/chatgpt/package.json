{
  "name": "@greenchat/chatgpt",
  "type": "module",
  "version": "1.0.1",
  "private": true,
  "description": "GreenChat (ChatGPT) estimates CO2 emissions of ChatGPT conversations to raise awareness about AI's environmental impact.",
  "scripts": {
    "build": "vite build --config vite.config.chrome.ts",
    "build:chrome": "vite build --config vite.config.chrome.ts",
    "build:firefox": "vite build --config vite.config.firefox.ts",
    "lint": "eslint --cache .",
    "lint:fix": "eslint --cache --fix .",
    "dev": "vite build --config vite.config.chrome.ts --mode development --watch",
    "dev:chrome": "vite build --config vite.config.chrome.ts --mode development --watch",
    "dev:firefox": "vite build --config vite.config.firefox.ts --mode development --watch"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.1.43",
    "@types/node": "^25.9.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/webextension-polyfill": "^0.12.6",
    "@typescript-eslint/parser": "^8.72.0",
    "@vitejs/plugin-react": "^5.2.0",
    "fs-extra": "^11.4.1",
    "globals": "^17.13.0",
    "tailwindcss": "^4.3.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vite-tsconfig-paths": "^6.1.1"
  }
}
